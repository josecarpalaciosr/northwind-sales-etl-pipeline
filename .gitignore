# Virtual environment
.venv/

# Python-generated files
__pycache__/
*.pyc
*.pyo
*.pyd

# Credentials and environment variables
.env

# Ignore raw databases by default
data/raw/*.db

# Include the Northwind source database
!data/raw/northwind.db

# Databases generated by the ETL
data/processed/*.db

# Generated logs
logs/*.log

# Local editor configuration
.vscode/

# Operating system files
.DS_Store
Thumbs.db