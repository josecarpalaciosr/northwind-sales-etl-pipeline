# Virtual environment
.venv/

# Python-generated files
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd

# Credentials and environment variables
.env

# Ignore raw databases by default
data/raw/*.db

# Include the Northwind source database
!data/raw/northwind.db

# Databases generated by the ETL
data/processed/*.db

# Generated logs
logs/*.log

# Local editor configuration
.vscode/

# Operating system files
.DS_Store
Thumbs.db

# Python package build artifacts (from python -m pip install -e .)
*.egg-info/
build/
dist/

# Ignore reproducible reporting exports generated locally.
data/exports/*.csv
!data/exports/.gitkeep

# Ignore intermediate Power BI workbooks; keep the final report versioned.
reports/Northwind_Sales_Analytics.pbix
reports/Northwind_Sales_Analytics_v2.pbix
reports/Northwind_Sales_Analytics_v2_pre_cleanup.pbix
